<section class="panel-formulario">
  <p class="etiqueta"><%= seccion %></p>
  <h1>Nueva reserva</h1>

  <% if (errores && errores.length > 0) { %>
    <div class="error" role="alert">
      <p>Revisá los siguientes datos:</p>
      <ul>
        <% errores.forEach((error) => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form class="formulario" action="/reservas" method="POST">
    <div>
      <label for="estudiante">Estudiante</label>
      <input
        type="text"
        id="estudiante"
        name="estudiante"
        value="<%= datos.estudiante || '' %>"
        required
      >
    </div>

    <div>
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= datos.email || '' %>"
        required
      >
    </div>

    <div>
      <label for="sala">Sala</label>
      <select id="sala" name="sala" required>
        <option value="">Seleccione una sala</option>
        <% salasPermitidas.forEach((sala) => { %>
          <option
            value="<%= sala %>"
            <%= datos.sala === sala ? "selected" : "" %>
          >
            <%= sala %>
          </option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="fecha">Fecha</label>
      <input
        type="date"
        id="fecha"
        name="fecha"
        value="<%= datos.fecha || '' %>"
        required
      >
    </div>

    <div>
      <label for="turno">Turno</label>
      <select id="turno" name="turno" required>
        <option value="">Seleccione un turno</option>
        <% turnosPermitidos.forEach((turno) => { %>
          <option
            value="<%= turno %>"
            <%= datos.turno === turno ? "selected" : "" %>
          >
            <%= turno %>
          </option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="personas">Cantidad de personas</label>
      <input
        type="number"
        id="personas"
        name="personas"
        min="1"
        max="6"
        step="1"
        value="<%= datos.personas || '' %>"
        required
      >
    </div>

    <button type="submit">Crear reserva</button>
  </form>

  <p>
    <a href="/reservas">Volver al listado</a>
  </p>
</section>